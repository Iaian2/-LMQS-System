# ============================================================
# RAG 智能问答系统 - 环境变量配置
# 复制此文件为 .env 并填写你的配置
# ============================================================

# --- 云端 API（推荐）---
# 支持 DeepSeek / OpenAI / 阿里百炼 / 智谱 等 OpenAI 兼容接口
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- HuggingFace 镜像（国内用户）---
HF_ENDPOINT=https://hf-mirror.com
